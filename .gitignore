# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-pipeline/
.pytest_cache/
.ruff_cache/

# --- Node / web ---
node_modules/
web/dist/
web/.vite/
# generated by web/copy-data.mjs (canonical copies live in data/artifacts + manifests)
web/public/data/
web/public/manifests/
*.tsbuildinfo

# --- Secrets / env (this repo is PUBLIC: never commit these) ---
# Real quantum-cloud tokens (IBM Quantum / AWS / Azure) are the operator's own, kept in a local .env and
# used only by the local precompute pipeline. The public static site ships NO secrets.
.env
.env.*
!.env.example

# --- Raw / heavy data (commit only compact rendered artifacts under data/artifacts/) ---
data/raw/
# raw statevector / large NumPy dumps: the committed artifacts are compact JSON traces only
*.npy
*.npz
*.h5
*.parquet

# --- OS ---
.DS_Store
Thumbs.db

# working notes, reviews and plans are not part of this repository
/wip/
